# Fitness AI Chatbot — Environment Configuration
# Copy this to .env and fill in your values.

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=fitness_chatbot

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8001

# --- JWT (generate: python -c "import secrets; print(secrets.token_hex(32))") ---
JWT_SECRET_KEY=CHANGE_THIS

# --- Groq STT (optional — voice input) ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Cloudflare Workers AI (optional — better intent parsing) ---
# https://dash.cloudflare.com → AI → Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/qwen/qwen2.5-coder-32b-instruct
